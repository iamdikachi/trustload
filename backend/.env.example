# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trustload?schema=public"

# File Storage (local directory for uploaded supplier invoices and final receipts)
UPLOAD_DIR="./uploads"

# PayPal Sandbox Integration (Orders, Payouts, Refunds, Webhooks)
PAYPAL_MODE="sandbox"
PAYPAL_API_BASE_URL="https://api-m.sandbox.paypal.com"
PAYPAL_CLIENT_ID="your_paypal_sandbox_client_id"
PAYPAL_CLIENT_SECRET="your_paypal_sandbox_client_secret"
PAYPAL_WEBHOOK_ID="your_paypal_sandbox_webhook_id"

# Multimodal AI (Invoice & Receipt Extraction + Verification)
GEMINI_API_KEY="your_gemini_api_key"
AI_MODEL="gemini-2.5-flash"

# Multi-Currency & FX Configuration
DEFAULT_BASE_CURRENCY="USD"
DISPLAY_CURRENCY="NGN"

# NestJS Observe (Optional Telemetry)
OBSERVE_APP_KEY="YOUR_APP_KEY"
OBSERVE_APP_SECRET="YOUR_APP_SECRET"

